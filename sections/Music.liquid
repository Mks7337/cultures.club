{% comment %}
  Eine Sektion mit einem YouTube-Video auf der linken Seite und Text auf der rechten Seite.
  Die Sektion ermöglicht das Hinzufügen von CTA-Schaltflächen.
{% endcomment %}

<div class="music-section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="music-container">
      <div class="music-video-wrapper">
        <div class="music-video-box" id="videoContainer-{{ section.id }}">
          {% if section.settings.video_url != blank %}
            {% assign video_id = section.settings.video_url | split: "v=" | last | split: "&" | first %}
            <iframe
              id="youtubeVideo-{{ section.id }}"
              src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              title="{{ section.settings.video_title | escape }}"
            ></iframe>
          {% else %}
            <div class="music-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
      </div>
      <div class="music-content">
        {% if section.settings.subtitle != blank %}
          <p class="music-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
        
        {% if section.settings.title != blank %}
          <h2 class="music-title">{{ section.settings.title }}</h2>
        {% endif %}
        
        {% if section.settings.tagline != blank %}
          <div class="music-tagline">{{ section.settings.tagline }}</div>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <div class="music-description">{{ section.settings.description }}</div>
        {% endif %}
        
        <div class="music-buttons">
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}">
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}
          
          {% if section.settings.button_label_2 != blank %}
            <a href="{{ section.settings.button_link_2 }}" class="button{% if section.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}">
              {{ section.settings.button_label_2 | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .music-section {
    padding: 0;
  }
  
  .music-container {
    display: flex;
    align-items: center;
    gap: 25px;
    min-height: 400px;
    padding: 40px 0;
    justify-content: center;
  }
  
  .music-video-wrapper {
    flex: 1.1;
    position: relative;
    min-height: 300px;
    margin-right: 5px;
  }
  
  .music-video-box {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    position: relative;
    background-color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .music-video-box:hover,
  .music-video-box.playing {
    transform: translate(-6px, -6px);
    box-shadow: 6px 6px 0 #6300FF;
  }
  
  .music-video-box iframe,
  .music-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  
  .music-placeholder {
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .music-content {
    flex: 0.9;
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .music-subtitle {
    font-size: 12px;
    margin-bottom: 0;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #505050;
    margin-top: 0;
  }
  
  .music-title {
    font-size: 60px;
    margin: 0 0 20px;
    font-weight: 900;
    line-height: 0.9;
    color: #000000;
    font-family: sans-serif;
    text-transform: uppercase;
  }
  
  .music-tagline {
    font-size: 16px;
    margin-bottom: 15px;
    font-weight: 500;
    color: #505050;
    line-height: 1.8;
  }
  
  .music-description {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 30px;
    color: #505050;
    max-width: 90%;
  }
  
  .music-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  
  .music-buttons .button {
    min-width: 160px;
    text-align: center;
    padding: 12px 20px;
    border-radius: 30px;
  }
  
  @media screen and (max-width: 749px) {
    .music-container {
      flex-direction: column;
      gap: 30px;
    }
    
    .music-video-wrapper,
    .music-content {
      width: 100%;
      flex: auto;
      margin: 0;
    }
    
    .music-title {
      font-size: 45px;
    }
    
    .music-description {
      max-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // YouTube API laden
    var tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    var firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
    
    // Video-Container finden
    var videoContainer = document.getElementById('videoContainer-{{ section.id }}');
    var iframe = document.getElementById('youtubeVideo-{{ section.id }}');
    
    if (iframe && videoContainer) {
      // Klick-Event für den Container (für Touch-Geräte)
      videoContainer.addEventListener('click', function() {
        videoContainer.classList.add('playing');
      });
      
      // YouTube Player API verwenden, wenn verfügbar
      window.onYouTubeIframeAPIReady = function() {
        // Warten auf die YouTube-API und dann Player erstellen
        new YT.Player('youtubeVideo-{{ section.id }}', {
          events: {
            'onStateChange': function(event) {
              // Wenn Video abgespielt wird (1) oder pausiert (2)
              if (event.data === YT.PlayerState.PLAYING || event.data === YT.PlayerState.PAUSED) {
                videoContainer.classList.add('playing');
              }
            }
          }
        });
      };
    }
  });
</script>

{% schema %}
{
  "name": "Music mit Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "LOFI MIX VOL. 01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "CHILL"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "<p>Proudly presenting out very first release: Chill | Lofi Mix Vol. 01</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung",
      "default": "<p>Mellow lofi vibes with a spherical touch. Influence in both chilled hip hop with minimal electronic elements.</p>"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube Video URL",
      "info": "Füge eine YouTube URL ein"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video Titel (für Barrierefreiheit)",
      "default": "Lofi Mix Video"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 Text",
      "default": "Watch on YouTube"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 Link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Button 1 im sekundären Stil anzeigen",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 Text"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 Link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "label": "Button 2 im sekundären Stil anzeigen",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Abstandseinstellungen"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Music mit Video",
      "category": "Video"
    }
  ]
}
{% endschema %}
