{{ 'section-social-proof.css' | asset_url | stylesheet_tag }}
{{ 'SocialScience-Cultures.otf' | asset_url | stylesheet_tag }}
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js" defer="defer"></script>
<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">

<div class="social-proof-section" id="social-proof-section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div class="section-header text-center">
        <h2>{{ section.settings.title | escape }}</h2>
        {% if section.settings.subtitle != blank %}
          <div class="rte">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="social-proof-slider" 
      data-flickity='{
        "cellAlign": "left",
        "contain": true,
        "groupCells": true,
        "wrapAround": true,
        "prevNextButtons": true,
        "pageDots": true,
        "autoPlay": {% if section.settings.autoplay %}{{ section.settings.cycle_speed | times: 1000 }}{% else %}false{% endif %}
      }'>
      {% for block in section.blocks %}
        <div class="social-proof-item" {{ block.shopify_attributes }}>
          <div class="social-proof-content">
            {% if block.settings.product_image != blank %}
              <div class="social-proof-image-container">
                {{ block.settings.product_image | image_url: width: 600 | image_tag: class: "social-proof-background-image", loading: 'lazy', alt: block.settings.product_image.alt | escape }}
                
                <div class="social-proof-glass-overlay">
                  <div class="social-proof-rating">
                    {% assign rating_value = block.settings.rating %}
                    {% for i in (1..5) %}
                      {% if i <= rating_value %}
                        <span class="star-filled">★</span>
                      {% else %}
                        <span class="star-empty">☆</span>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if block.settings.testimonial != blank %}
                    <div class="social-proof-testimonial">
                      {{ block.settings.testimonial }}
                    </div>
                  {% endif %}
                  
                  <div class="social-proof-customer">
                    {% if block.settings.customer_image != blank %}
                      <div class="social-proof-customer-image">
                        {{ block.settings.customer_image | image_url: width: 50 | image_tag: class: 'customer-avatar', loading: 'lazy', alt: block.settings.customer_name | escape }}
                      </div>
                    {% endif %}
                    
                    {% if block.settings.customer_name != blank %}
                      <div class="social-proof-customer-name">
                        {{ block.settings.customer_name }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: 'SocialScience-Cultures';
    src: url("{{ 'SocialScience-Cultures.otf' | asset_url }}") format("opentype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  
  .social-proof-section {
    padding: 60px 0;
  }
  
  .social-proof-slider {
    margin-top: 40px;
    overflow: visible;
  }
  
  .social-proof-item {
    width: 320px;
    padding: 0 15px;
  }
  
  @media screen and (max-width: 749px) {
    .social-proof-item {
      width: 280px;
    }
  }
  
  .social-proof-content {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: none;
    height: 100%;
    position: relative;
  }
  
  .social-proof-image-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 150%;
    overflow: hidden;
  }
  
  .social-proof-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .social-proof-glass-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 33.33%;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .social-proof-rating {
    font-size: 16px;
    margin-bottom: 4px;
    margin-top: -5px;
  }
  
  .star-filled {
    color: #fff900;
    text-shadow: 0 0 5px rgba(255, 249, 0, 0.5);
    display: inline-block;
    border-radius: 3px;
    transform: scale(1.1);
  }
  
  .star-empty {
    color: #e0e0e0;
    display: inline-block;
    border-radius: 3px;
  }
  
  .social-proof-testimonial {
    margin-bottom: 3px;
    margin-top: -3px;
    font-style: italic;
    font-size: 14px;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: #000000;
    text-shadow: none;
  }
  
  .social-proof-customer {
    display: flex;
    align-items: center;
    margin-top: 5px;
    justify-content: flex-start;
  }
  
  .social-proof-customer-image {
    margin-right: 12px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #fff;
    flex-shrink: 0;
  }
  
  .social-proof-customer-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .social-proof-customer-name {
    font-family: 'SocialScience-Cultures', sans-serif;
    font-weight: normal;
    font-size: 16px;
    color: #000000;
    text-shadow: none;
    display: flex;
    align-items: center;
  }
</style>

{% schema %}
{
  "name": "Social Proof",
  "class": "social-proof",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift",
      "default": "Das sagen unsere Kunden"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "<p>Erfahrungen unserer zufriedenen Kunden</p>"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-Rotation aktivieren",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Wechsel-Intervall",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Hauptbild (Hintergrund)"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Bewertung",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "testimonial",
          "label": "Testimonial Text",
          "default": "Tolles Produkt! Ich bin sehr zufrieden mit meinem Kauf."
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Kundenbild"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Kundenname",
          "default": "Max Mustermann"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
