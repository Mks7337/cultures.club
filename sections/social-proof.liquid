{{ 'section-social-proof.css' | asset_url | stylesheet_tag }}
{{ 'SocialScience-Cultures.otf' | asset_url | stylesheet_tag }}
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js" defer="defer"></script>
<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">

<div class="social-proof-section" id="social-proof-section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div class="section-header text-center">
        <h2 class="section-title" style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.title | escape }}</h2>
        {% if section.settings.subtitle != blank %}
          <div class="rte section-subtitle" style="font-size: {{ section.settings.subheading_size }}px;">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="social-proof-slider" 
      data-flickity='{
        "cellAlign": "left",
        "contain": true,
        "groupCells": true,
        "wrapAround": true,
        "prevNextButtons": true,
        "pageDots": true,
        "autoPlay": {% if section.settings.autoplay %}{{ section.settings.cycle_speed | times: 1000 }}{% else %}false{% endif %}
      }'>
      {% for block in section.blocks %}
        <div class="social-proof-item" {{ block.shopify_attributes }}>
          <div class="social-proof-content">
            {% if block.settings.product_image != blank %}
              <div class="social-proof-image-container">
                {{ block.settings.product_image | image_url: width: 600 | image_tag: class: "social-proof-background-image", loading: 'lazy', alt: block.settings.product_image.alt | escape }}
                
                {% if block.settings.customer_image != blank and block.settings.customer_name != blank %}
                  <div class="social-proof-user-info">
                    <div class="social-proof-customer-image">
                      {{ block.settings.customer_image | image_url: width: 50 | image_tag: class: 'customer-avatar', loading: 'lazy', alt: block.settings.customer_name | escape }}
                    </div>
                    <div class="social-proof-customer-name">
                      {{ block.settings.customer_name }}
                    </div>
                  </div>
                {% endif %}
                
                <div class="social-proof-glass-overlay">
                  <div class="social-proof-rating">
                    {% assign rating_value = block.settings.rating %}
                    {% for i in (1..5) %}
                      {% if i <= rating_value %}
                        <span class="star-filled">★</span>
                      {% else %}
                        <span class="star-empty">☆</span>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if block.settings.testimonial != blank %}
                    <div class="social-proof-testimonial">
                      {{ block.settings.testimonial }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: 'SocialScience-Cultures';
    src: url("{{ 'SocialScience-Cultures.otf' | asset_url }}") format("opentype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  
  .social-proof-section {
    padding: 60px 0;
  }
  
  .social-proof-slider {
    margin-top: 40px;
    overflow: visible;
    padding-top: 10px;
  }
  
  .social-proof-item {
    width: 300px;
    padding: 0 15px 10px;
    margin-top: 6px;
  }
  
  @media screen and (max-width: 749px) {
    .social-proof-item {
      width: 280px;
    }
  }
  
  .social-proof-content {
    border-radius: 0;
    overflow: hidden;
    box-shadow: none;
    height: 100%;
    position: relative;
    transition: border-radius 0.3s ease, transform 0.3s ease;
  }
  
  .social-proof-content:hover {
    border-radius: 4px;
    transform: translateY(-6px);
  }
  
  .social-proof-image-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 150%;
    overflow: hidden;
  }
  
  .social-proof-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .social-proof-user-info {
    position: absolute;
    top: 11px;
    left: 15px;
    display: flex;
    align-items: center;
    z-index: 2;
  }
  
  .social-proof-customer-image {
    margin-right: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #fff;
    flex-shrink: 0;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }
  
  .social-proof-customer-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .social-proof-customer-name {
    font-family: 'SocialScience-Cultures', sans-serif;
    font-weight: normal;
    font-size: 22px;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }
  
  .social-proof-glass-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 25%;
    background: linear-gradient(to top, 
                rgba(255, 255, 255, 0.4) 70%, 
                rgba(255, 255, 255, 0) 100%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  
  .social-proof-rating {
    font-size: 20px;
    margin: -8px 0 8px 0;
    text-align: center;
  }
  
  .star-filled {
    color: #6300FF;
    text-shadow: 0 0 5px rgba(99, 0, 255, 0.5);
    display: inline-block;
    border-radius: 3px;
    transform: scale(1.2);
  }
  
  .star-empty {
    color: #e0e0e0;
    display: inline-block;
    border-radius: 3px;
    transform: scale(1.2);
  }
  
  .social-proof-testimonial {
    margin-top: -1px;
    font-style: italic;
    font-size: 14px;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    text-align: center;
  }

  .flickity-button {
    background: #FFFFFF;
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    transition: all 0.2s ease;
    position: absolute;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  .flickity-button:hover {
    background: #F8F8F8;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
  }

  .flickity-prev-next-button {
    width: 30px;
    height: 30px;
  }

  .flickity-prev-next-button.previous {
    left: 10px;
  }

  .flickity-prev-next-button.next {
    right: 10px;
  }

  .flickity-button-icon {
    fill: #6300FF;
    width: 30%;
    height: 30%;
  }

  .flickity-button:disabled {
    display: none;
  }

  .flickity-page-dots {
    bottom: -30px;
  }

  .flickity-page-dots .dot {
    width: 6px;
    height: 6px;
    margin: 0 4px;
    background: #cccccc;
    opacity: 0.5;
    transition: opacity 0.3s ease, background 0.3s ease;
  }

  .flickity-page-dots .dot.is-selected {
    opacity: 1;
    background: #6300FF;
  }

  .section-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .section-title {
    margin-bottom: 15px;
  }

  .section-subtitle {
    margin: 0 auto;
    max-width: 700px;
  }
</style>

{% schema %}
{
  "name": "Social Proof",
  "class": "social-proof",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift",
      "default": "Das sagen unsere Kunden"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Überschriftgröße",
      "default": 32
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "<p>Erfahrungen unserer zufriedenen Kunden</p>"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Untertitelgröße",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-Rotation aktivieren",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Wechsel-Intervall",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Hauptbild (Hintergrund)"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Bewertung",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "testimonial",
          "label": "Testimonial Text",
          "default": "Tolles Produkt! Ich bin sehr zufrieden mit meinem Kauf."
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Kundenbild"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Kundenname",
          "default": "Max Mustermann"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
